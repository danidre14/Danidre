NODE_ENV=development
PORT=3000
SESSION_SECRET=your_session_secret_here
DATABASE_URL=mongodb://username:password@host:port/dbname
ADMIN_NAME=your_admin_username
# ADMIN_KEY should be a bcrypt hash of your admin passkey (use scripts/hash_admin_key.js)
ADMIN_KEY=$2b$10$examplebcrypthashreplace
EMAIL_HOST=smtp-relay.sendinblue.com
EMAIL_PORT=587
EMAIL_USER=your_brevo_login_email@smtp-brevo.com
EMAIL_PASS=your_smtp_key_here
EMAIL_SENDER=no-reply@mydomain.com_or_EMAIL_USER
RECAPTCHA_SITE_KEY=your_site_key_here # (from google recaptcha admin console)
RECAPTCHA_SECRET=your_secret_here # (from google recaptcha admin console)